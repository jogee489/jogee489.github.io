---
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import Console from '../components/Console.astro';
import Contact from '../components/Contact.astro';
import DeskIntro from '../components/DeskIntro.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import RepoMarquee from '../components/RepoMarquee';
import Side from '../components/Side.astro';
import '../styles/portfolio.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const shellProjects = projects.map(p => ({
  id: p.id,
  name: p.data.name,
  stack: p.data.stack.join(', '),
  blurb: p.data.blurb,
  url: `https://${p.data.repo}`,
}));
const description = 'Backend engineer with over ten years of Rails, Java and Linux. Available for freelance work.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#12100d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>JJ Dorko · Backend Engineer</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="JJ Dorko · Backend Engineer" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Mona+Sans:wdth,wght@75..125,200..900&family=Red+Hat+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-arrow" viewBox="0 0 16 16">
        <path d="M4.5 11.5l7-7M6 4.5h5.5V10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
    </svg>
    <a class="skip" href="#about">Skip to content</a>

    <DeskIntro phoneShot={projects.find(p => p.data.image)?.data.image} />

    <div class="page">
      <Side />
      <main>
        <About />
        <Experience />
        <Projects />
        <section id="repos">
          <h2 class="sec-h">Repos</h2>
          <div class="repos-head">
            <p>Everything else on GitHub</p>
            <a href="https://github.com/jogee489?tab=repositories" target="_blank" rel="noreferrer">
              All repos <svg class="ico" aria-hidden="true"><use href="#i-arrow" /></svg>
            </a>
          </div>
          <RepoMarquee client:load />
        </section>
        <Contact />
        <footer class="colophon">
          <p>Designed and built by JJ Dorko with Astro and three.js. Set in Mona Sans and Red Hat Mono.</p>
          <p>Press <kbd>`</kbd> anywhere for the full-screen shell.</p>
        </footer>
      </main>
    </div>

    <Console projects={shellProjects} />
  </body>
</html>
