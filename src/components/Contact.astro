---
import { LINKEDIN_URL } from '../data/links';
import ContactForm from './ContactForm';
---

<section id="contact" class="contact">
  <h2>Looking for an engineer?</h2>
  <p>
    I'm looking for a full-time software engineering role on an English-speaking team, in Osaka, Tokyo or remote.
    I also take contract work: upgrading older Rails apps and getting them under test, building features in Rails,
    Vue or TypeScript, and setting up CI/CD and AWS deploys. I'm based in Osaka and don't need visa sponsorship.
    Send a note below, email <a href="mailto:jdorko90@gmail.com">jdorko90@gmail.com</a>, or find me on
    <a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>.
  </p>
  <ContactForm client:load />
</section>
