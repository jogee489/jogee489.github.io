---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// The first project with a screenshot gets the featured slot; the rest are a list
const featured = projects.find(p => p.data.image);
const rest = projects.filter(p => p !== featured);
const href = (repo: string) => `https://${repo}`;
---

<section id="work">
  <h2 class="sec-h">Work</h2>
  {featured && (
    <article class="feature">
      <img src={featured.data.image} alt={`${featured.data.name} app screen`} width="1080" height="2400" loading="lazy" />
      <div>
        <h3>{featured.data.name}</h3>
        <p class="meta">{featured.data.stack.join(', ')}</p>
        <p class="desc">{featured.data.blurb}</p>
        <a class="go" href={href(featured.data.repo)} target="_blank" rel="noreferrer">
          Source <svg class="ico" aria-hidden="true"><use href="#i-arrow" /></svg>
        </a>
      </div>
    </article>
  )}
  <ul class="projects">
    {rest.map(p => (
      <li>
        <a href={href(p.data.repo)} target="_blank" rel="noreferrer">
          <span class="n">{p.data.name} <svg class="ico" aria-hidden="true"><use href="#i-arrow" /></svg></span>
          <span class="s">{p.data.stack.join(', ')}</span>
          <p class="b">{p.data.blurb}</p>
        </a>
      </li>
    ))}
  </ul>
</section>
